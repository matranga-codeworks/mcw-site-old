---
import {
  CONTACT_EMAIL,
  COMPANY_LEGAL_NAME,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
} from "@lib/company";
import { Image } from "astro:assets";

import "../styles/global.css";

import headshot from "@assets/Frank_Headshot.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="viewport-fit=cover, width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Matranga Codeworks</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="theme-color" content="rgba(252, 70, 107, 1)" />
  </head>
  <body
    class="h-[100dvh] font-display text-text-dark p-8 flex flex-col place-content-center"
  >
    <section
      class="flex flex-col gap-2 items-center bg-white max-w-[400px] mx-auto p-8 rounded-2xl shadow-lg text-center"
    >
      <Image
        src={headshot}
        alt="Frank Matranga Headshot"
        class="w-[100px] rounded-full"
      />
      <h1 class="text-3xl font-bold">Frank Matranga</h1>
      <h2 class="text-lg text-gray-600">{COMPANY_LEGAL_NAME}</h2>
      <p class="text-base">
        Phone:{" "}
        <a class="text-blue-600 hover:underline" href={`tel:${CONTACT_PHONE}`}>
          {CONTACT_PHONE_DISPLAY}
        </a>
      </p>
      <p class="text-base">
        Email:{" "}
        <a
          class="text-blue-600 hover:underline"
          href={"mailto:" + CONTACT_EMAIL}
        >
          {CONTACT_EMAIL}
        </a>
      </p>
      <div>
        <a href="/frank-matranga.vcf" download>
          <img
            src="/qr-contact-card.png"
            alt="QR code to download contact card"
            class="w-[120px] mx-auto"
          />
          <p class="text-sm text-gray-500 mt-2">
            Scan or tap to download my contact card
          </p>
        </a>
      </div>
    </section>
    <script>
      const debug = document.getElementById("debug");
      const card = document.querySelector("section") as HTMLDivElement;
      function enableOrientation() {
        const debug = document.getElementById("debug");
        const card = document.querySelector("section") as HTMLElement | null;
        window.addEventListener("deviceorientation", (event) => {
          const gamma = event.gamma || 0; // left-right tilt
          const beta = event.beta || 0; // front-back tilt
          // Map orientation to gradient center
          // When phone is flat, beta ~0, gamma ~0
          const x = 50 + gamma * 1.5; // left/right pan, less sensitive
          const y = 50 + beta * 1.5; // up/down pan, less sensitive
          document.body.style.background = `radial-gradient(circle at ${x}% ${y}%, rgba(63,94,251,1) 0%, rgba(252,70,107,1) 100%)`;
        });
      }

      function requestOrientationPermissionIfNeeded() {
        if (
          typeof DeviceOrientationEvent !== "undefined" &&
          typeof DeviceOrientationEvent.requestPermission === "function"
        ) {
          DeviceOrientationEvent.requestPermission().then((response) => {
            if (response === "granted") {
              enableOrientation();
            }
          });
        } else {
          enableOrientation();
        }
      }

      document.addEventListener("click", function activateOrientationOnce() {
        requestOrientationPermissionIfNeeded();
        document.removeEventListener("click", activateOrientationOnce);
      });
    </script>
  </body>
</html>

<style>
  body {
    background-color: #3f5efb;
    background: radial-gradient(
      circle,
      rgba(63, 94, 251, 1) 0%,
      rgba(252, 70, 107, 1) 100%
    );
  }
</style>
