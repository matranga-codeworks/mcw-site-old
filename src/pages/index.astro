---
import { SEO } from "astro-seo";
import { Image } from "astro:assets";

import { CONTACT_EMAIL, CONTACT_PHONE, CONTACT_PHONE_DISPLAY } from "@lib/company";
import Icon from "@components/LucideIcon.astro";
import Monogram from "@assets/monogram.svg";
import HeadshotImg from "@assets/Frank_Headshot.jpg";
import PCCWordmark from "@assets/organizations/pcc_wordmark.png";
import RCOSLockup from "@assets/organizations/rcos_lockup.png";

import "../styles/site/colors_and_type.css";
import "../styles/site/components.css";
import "../styles/site/site.css";

const specs = [
  ["Discipline", "Custom software"],
  ["Based in", "Cohoes, NY"],
  ["Serving", "Small biz · Non-profits"],
  ["Experience", "5+ years"],
  ["Booking", "Summer 2026"],
];

const services = [
  {
    n: "01",
    icon: "blocks",
    title: "Custom Business Software",
    body: "Off-the-shelf only gets you so far. I build systems designed around the way your organization actually works — inventory management, fundraising tools, customer portals — instead of forcing you to change how you operate.",
  },
  {
    n: "02",
    icon: "layout-grid",
    title: "Websites & Mobile Apps",
    body: "Easy-to-use websites and apps that work smoothly on any phone, tablet, or computer — whether they’re tools for your team or something built for your customers to use.",
  },
  {
    n: "03",
    icon: "drafting-compass",
    title: "Technical Guidance & Planning",
    body: "Already have a developer but need direction? I help you and your team plan software that’s built to last and grows with your business — so you avoid costly mistakes down the road.",
  },
  {
    n: "04",
    icon: "wrench",
    title: "Ongoing Development & Support",
    body: "Upkeep, new features, and a real person to call when you need help — keeping things running smoothly as you grow. I don’t disappear once the project is finished.",
  },
] as const;

const work = [
  {
    id: "pcc",
    client: "Preston Center of Compassion",
    type: "Non-profit",
    duo: "duo-navy",
    title: "Online Fundraiser Platform",
    result:
      "Took a Bronx non-profit’s signature fundraiser fully online during the pandemic.",
    summary:
      "A virtual platform for PCC’s major summer fundraiser: locals log in on desktop or mobile to make realtime donations, buy raffle tickets, and reserve dinner seats. Administrators manage the event live, track donations, and download Excel reports at any time.",
    stats: [
      ["Live", "Donations in real time"],
      ["Secure", "Online payments"],
      ["Anywhere", "Phone or computer"],
    ],
    stack: "Web app · Online donations & payments",
  },
  {
    id: "soapbox",
    client: "Soapbox Hosting",
    type: "Own product",
    duo: "duo-steel",
    title: "Podcast Hosting Platform",
    result:
      "My own platform to record, edit, and publish a podcast — all from one website.",
    summary:
      "Soapbox makes launching and managing a podcast simple from start to finish — fast, reliable, and easy to use whether you’re a seasoned podcaster or just getting started.",
    stats: [
      ["All-in-one", "Record · Edit · Publish"],
      ["Online", "Works in any browser"],
      ["Simple", "No setup needed"],
    ],
    stack: "Online platform",
  },
  {
    id: "rcos",
    client: "Rensselaer Center for Open Source",
    type: "Pro bono",
    duo: "duo-deep",
    title: "RCOS.io Operations Hub",
    result:
      "The central hub tracking hundreds of students and dozens of open-source projects each semester.",
    summary:
      "When RCOS scaled to hundreds of enrolled students and dozens of active projects, it needed a robust home. I built and maintain RCOS.io — tracking students, faculty advisors, projects, teams across semesters, meetings, and event attendance. Hosted affordably and maintained for free to give back to a community that shaped my early career at RPI.",
    stats: [
      ["100s", "Students tracked"],
      ["Dozens", "Projects managed"],
      ["Free", "Maintained pro bono"],
    ],
    stack: "Web application",
  },
] as const;

const clients = [
  { name: "Preston Center of Compassion", sub: "Bronx, NY · Non-profit", logo: PCCWordmark },
  { name: "Rensselaer Center for Open Source", sub: "Troy, NY · RPI", logo: RCOSLockup },
  { name: "Soapbox Hosting", sub: "Podcast platform", logo: null },
];

const steps = [
  [
    "Book a free call",
    "Grab a consultation slot — a relaxed, no-charge call to talk through your goals, challenges, and timeline.",
  ],
  [
    "Discovery",
    "Before proposing anything, I take time to understand how your organization really works — your day-to-day, your bottlenecks, and what success looks like for you.",
  ],
  [
    "Proposal",
    "Only then do I send a detailed proposal, with an approach and pricing shaped around what I learned.",
  ],
  ["Kickoff", "Once you approve, I schedule a kickoff meeting and start building."],
];

const faqs = [
  {
    q: "Do I need to be technical to work with you?",
    a: "Not at all — most of the people I work with run businesses and non-profits, not software teams. I handle the technical side and explain everything in plain language, so you always understand what you’re getting and why. You bring the knowledge of how your organization works; I bring the engineering.",
  },
  {
    q: "What does custom software cost?",
    a: "Project costs vary with complexity and scope, typically ranging from $10,000 for simple business tools to $75,000+ for fully comprehensive systems. I provide detailed estimates after understanding your needs, and always discuss budget upfront so we’re on the same page.",
  },
  {
    q: "What are the ongoing costs after launch?",
    a: "Beyond the build, you’ll usually have modest monthly costs for things like hosting and a domain name — often $20–$100 a month depending on the project. I lay these out clearly before we start, so there are no surprises, and I help you get everything set up.",
  },
  {
    q: "Do you offer payment plans?",
    a: "Yes. I structure payments around project milestones, so you’re never paying for work that hasn’t been completed — most projects split into 3–4 payments, often 25% upfront, 50% at milestones, and 25% at completion.",
  },
  {
    q: "Do you offer discounts?",
    a: "Yes — I offer discounts for non-profit organizations, educational institutions, and churches. Let’s discuss your specific situation during the consultation.",
  },
  {
    q: "How long do projects typically take?",
    a: "Simple applications usually take 6–12 weeks, while comprehensive business systems can take 3–6 months. I give realistic timelines upfront and keep you updated on progress throughout.",
  },
  {
    q: "Will it work with the tools I already use?",
    a: "In most cases, yes. I build around the tools you already rely on — your payment processor, accounting software, email marketing, or donor database — so your new software fits how you already work instead of replacing everything.",
  },
  {
    q: "Can you fix or take over software someone else built?",
    a: "Absolutely. I regularly step in to repair, improve, or take over projects started by a previous developer — including unfinished work or a site you’ve lost access to. I’ll review what exists, tell you honestly what’s worth keeping, and map out a path forward.",
  },
  {
    q: "Will I own the source code?",
    a: "Absolutely. You’ll own all code, designs, and intellectual property created for your project. I also provide documentation, so you’re never locked into working only with me.",
  },
  {
    q: "What if something breaks after launch?",
    a: "I include a 90-day warranty on all work, and offer ongoing maintenance plans for long-term support. Since I’m local, I can respond quickly when you need help.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <SEO
      title="Matranga Codeworks — Custom Software for the NY Capital Region"
      description="Custom, local software for New York Capital Region small businesses and non-profits — built by one engineer right here in the community."
      canonical="https://matrangacodeworks.com"
      charset="UTF-8"
    />

    <!-- Start of HubSpot Embed Code -->
    <script
      type="text/javascript"
      id="hs-script-loader"
      async
      defer
      src="//js-na2.hs-scripts.com/243671711.js"></script>
    <!-- End of HubSpot Embed Code -->

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="announce">
      Now booking projects for Summer 2026 and beyond —{" "}
      <a href="#contact">get in touch</a> or call <a href={"tel:" + CONTACT_PHONE}
        >(518)&nbsp;217&#8209;8298</a
      >.
    </div>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="#top">
          <Monogram width={30} height={30} style="color: var(--ink)" aria-hidden="true" />
          <b>Matranga&nbsp;Codeworks</b>
        </a>
        <nav class="nav">
          <a class="navlink" href="#services">Services</a>
          <a class="navlink" href="#work">Work</a>
          <a class="navlink" href="#about">About</a>
          <a class="navlink" href="#faq">FAQ</a>
          <a class="btn btn--primary btn--sm" href="#contact">Free consultation</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero band-blue" id="top">
        <span class="reg-mark" style="top:18px;left:18px;color:var(--draft-cyan)"></span>
        <span class="reg-mark" style="top:18px;right:18px;color:var(--draft-cyan)"></span>
        <div class="wrap">
          <div>
            <span class="eyebrow" style="color:var(--brass-bright)"
              >Custom software · Cohoes, NY</span
            >
            <h1>Your local software&nbsp;partner.</h1>
            <p class="lead">
              Custom software for New York Capital Region small businesses and
              non&#8209;profits — built around the way your organization actually
              works, by one engineer who's right here in the community.
            </p>
            <div class="hero-cta">
              <a class="btn btn--on-blue btn--lg" href="#contact">Free consultation</a>
              <a
                class="btn btn--lg"
                href="#work"
                style="color:var(--blueprint-ink);border-color:var(--blueprint-600)"
                >See featured work</a
              >
            </div>
          </div>
          <div class="hero-spec">
            <span class="reg-mark" style="top:10px;right:10px;color:var(--blueprint-ink-2)"
            ></span>
            <div
              style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--blueprint-ink-2);margin-bottom:8px"
            >
              The works · spec sheet
            </div>
            {
              specs.map(([k, v]) => (
                <div class="spec-row">
                  <span class="k">{k}</span>
                  <span class="v">{v}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Services -->
      <section class="section" id="services">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Section 01 — Capabilities</span>
            <h2 class="section-title">How I help your local organization grow</h2>
          </div>
          <div class="svc-grid">
            {
              services.map((it, i) => (
                <div class="svc-card reveal" style={`transition-delay:${i * 70}ms`}>
                  <span class="num">{it.n}</span>
                  <Icon name={it.icon} size={30} color="var(--brass-deep)" />
                  <h3>{it.title}</h3>
                  <p>{it.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Featured work -->
      <section class="section band-blue" id="work">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow" style="color:var(--brass-bright)"
              >Section 02 — Featured projects</span
            >
            <h2 class="section-title">A few things I’ve built</h2>
          </div>
          <div class="work-grid">
            {
              work.map((w, i) => (
                <button
                  type="button"
                  class="work-card reveal"
                  style={`transition-delay:${i * 80}ms`}
                  data-open-work={w.id}
                >
                  <div class={"work-img " + w.duo}>
                    <span class="badge">{w.type}</span>
                  </div>
                  <div class="work-body">
                    <h3>{w.title}</h3>
                    <p class="result">{w.result}</p>
                    <span class="more">
                      View case{" "}
                      <Icon name="arrow-right" size={14} color="var(--brass-deep)" />
                    </span>
                  </div>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Clients / logo wall -->
      <section class="section--tight clients-band">
        <div class="wrap">
          <div class="clients-head">
            <span class="eyebrow">Trusted by</span>
            <h2 class="clients-title">Organizations I’ve worked with</h2>
          </div>
          <div class="client-grid">
            {
              clients.map((c, i) => (
                <div class="reveal" style={`transition-delay:${i * 70}ms`}>
                  <div class="client-mark" title={c.name}>
                    <span class="reg-mark" style="top:8px;left:8px;color:var(--hairline-2)" />
                    <span class="reg-mark" style="top:8px;right:8px;color:var(--hairline-2)" />
                    {c.logo ? (
                      <Image src={c.logo} alt={c.name} width={320} densities={[1, 2]} />
                    ) : (
                      <span class="wordmark">{c.name}</span>
                    )}
                    {c.sub && <span class="client-sub">{c.sub}</span>}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="clients-note">
            Proudly serving small businesses &amp; non-profits across Albany, Troy,
            Schenectady, Saratoga &amp; the greater Capital Region.
          </p>
        </div>
      </section>

      <!-- Testimonial -->
      <section
        class="section--tight"
        style="background:var(--paper-2);border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)"
      >
        <div class="wrap">
          <div class="quote-wrap reveal">
            <div class="quote-mark">&ldquo;</div>
            <p class="quote-body">
              We’ve worked with Frank for years and he’s been amazing. He helped us take
              our fundraisers online during the pandemic so we could keep supporting the
              Bronx community. He really understands what we’re trying to do — everything
              from our fundraising events to summer camp and afterschool programs runs more
              smoothly and reaches more families than ever before.
            </p>
            <div class="quote-attr">— Preston Center of Compassion</div>
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="section about--paper" id="about">
        <div class="wrap">
          <div class="about-grid">
            <div class="portrait reveal">
              <Image
                src={HeadshotImg}
                alt="Frank Matranga"
                width={320}
                height={400}
                class="portrait-img"
              />
              <span class="portrait-scrim"></span>
              <span class="reg-mark" style="top:12px;left:12px;color:var(--draft-cyan)"></span>
              <span class="reg-mark" style="top:12px;right:12px;color:var(--draft-cyan)"></span>
              <span class="tag">FRANK MATRANGA · COHOES, NY</span>
            </div>
            <div class="reveal" style="transition-delay:90ms">
              <span class="eyebrow">Section 03 — Your local technical partner</span>
              <h2 style="margin-top:16px">
                Right here in the community, when you need&nbsp;support.
              </h2>
              <p>
                I’m Frank Matranga — a NYC-born software engineer and current Director of
                Engineering at a healthcare technology company, with a dual degree from RPI
                in Computer Science &amp; Information Technology and Web Science.
              </p>
              <p>
                I’ve spent 5+ years building systems local businesses depend on every day.
                After seven years in the Capital Region, I’m invested in seeing our local
                organizations thrive — work with me and you’re partnering with someone who
                cares about your success and is right here when you need support.
              </p>
              <p style="color:var(--ink-3);font-size:15.5px">
                When I’m not coding, you’ll find me coworking in Troy over an iced chai,
                hiking the Catskills, or wandering Hudson Valley farmers’ markets.
              </p>
              <div class="sig">— Frank Matranga</div>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section" id="faq">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Section 04 — Common questions</span>
            <h2 class="section-title">Frequently asked questions</h2>
          </div>
          <div class="faq-list">
            {
              faqs.map((f, i) => (
                <div class={"faq-item" + (i === 0 ? " open" : "")}>
                  <button class="faq-q" aria-expanded={i === 0 ? "true" : "false"}>
                    {f.q}
                    <span class="chev">
                      <Icon name="plus" size={20} color="var(--brass-deep)" />
                    </span>
                  </button>
                  <div class="faq-a">
                    <p>{f.a}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="section" id="contact">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Section 05 — Start a project</span>
            <h2 class="section-title">Interested in working together?</h2>
            <p
              style="font-size:17px;line-height:1.6;color:var(--ink-2);margin:0;max-width:54ch"
            >
              Pick a time that works for you and we’ll talk — a free consultation to get to
              know you, your organization, and its needs. No charge, no obligation.
            </p>
          </div>
          <div class="contact-grid contact-grid--book">
            <div class="schedule">
              <div class="schedule-head">
                <Icon name="calendar-check" size={18} color="var(--brass-deep)" />
                <span>Book a free consultation</span>
              </div>
              <!-- Google Calendar Appointment Scheduling begin -->
              <iframe
                title="Schedule a free consultation with Frank Matranga"
                src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3MX94psMGAFeCoftM2SwascHtxoRfUt1k8t3HSvZto2cFc9JuAYmKQ7h0kmv_00HgTaHkqGKOf?gv=true"
                width="100%"
                height="640"
                style="border:0;display:block"></iframe>
              <!-- end Google Calendar Appointment Scheduling -->
            </div>
            <div class="contact-aside">
              <div class="proc">
                {
                  steps.map(([t, d], i) => (
                    <div class="proc-step">
                      <span class="proc-n">{String(i + 1).padStart(2, "0")}</span>
                      <div>
                        <div class="proc-t">{t}</div>
                        <div class="proc-d">{d}</div>
                      </div>
                    </div>
                  ))
                }
              </div>
              <div class="contact-lines">
                <a class="line" href={"mailto:" + CONTACT_EMAIL}>
                  <Icon name="mail" size={18} color="var(--brass-deep)" />
                  {CONTACT_EMAIL}
                </a>
                <a class="line" href={"tel:" + CONTACT_PHONE}>
                  <Icon name="phone" size={18} color="var(--brass-deep)" />
                  {CONTACT_PHONE_DISPLAY}
                </a>
                <span class="line">
                  <Icon name="map-pin" size={18} color="var(--brass-deep)" />
                  Cohoes, New York
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer band-blue" id="footer">
      <div class="wrap">
        <div class="footer-top">
          <a class="brand" href="#top" style="align-items:flex-start">
            <Monogram
              width={38}
              height={38}
              style="color: var(--blueprint-ink)"
              aria-hidden="true"
            />
            <span>
              <b style="color:var(--blueprint-ink);display:block">Matranga&nbsp;Codeworks</b>
              <span
                style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.16em;color:var(--draft-cyan)"
                >YOUR LOCAL SOFTWARE PARTNER</span
              >
            </span>
          </a>
          <div class="footer-cols">
            <div class="footer-col">
              <span class="h">Studio</span>
              <a href="#services">Services</a>
              <a href="#work">Featured work</a>
              <a href="#about">My story</a>
              <a href="#faq">FAQ</a>
              <a href="#contact">Free consultation</a>
            </div>
            <div class="footer-col">
              <span class="h">Get in touch</span>
              <a href={"mailto:" + CONTACT_EMAIL}>{CONTACT_EMAIL}</a>
              <a href={"tel:" + CONTACT_PHONE}>{CONTACT_PHONE_DISPLAY}</a>
              <a href="https://www.linkedin.com/in/frank-matranga/" target="_blank" rel="noreferrer"
                >LinkedIn</a
              >
              <a href="#footer">Cohoes, NY</a>
            </div>
          </div>
        </div>
        <div class="footer-rule"></div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} MATRANGA CODEWORKS LLC · ALL RIGHTS RESERVED</span>
          <span>BUILT IN NEW YORK'S CAPITAL REGION</span>
        </div>
      </div>
    </footer>

    <!-- Case-study modals -->
    {
      work.map((w) => (
        <div class="modal-scrim" data-modal={w.id} style="display:none">
          <div class="modal">
            <div class={"mhead " + w.duo}>
              <button class="mclose" aria-label="Close">
                <Icon name="x" size={18} color="#fff" />
              </button>
              <span
                class="badge"
                style="background:rgba(11,34,54,0.7);color:var(--draft-cyan);border-color:rgba(141,186,228,0.4)"
              >
                {w.type}
              </span>
            </div>
            <div class="mbody">
              <div
                style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;color:var(--ink-3);margin-bottom:6px"
              >
                {w.client}
              </div>
              <h3>{w.title}</h3>
              <div class="stat-row">
                {w.stats.map(([n, l]) => (
                  <div class="stat">
                    <div class="n">{n}</div>
                    <div class="l">{l}</div>
                  </div>
                ))}
              </div>
              <p style="font-size:16px;line-height:1.62;color:var(--ink-2);margin:0">
                {w.summary}
              </p>
              <div
                style="margin-top:22px;display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:12px;color:var(--brass-deep);letter-spacing:0.04em"
              >
                <Icon name="blocks" size={16} color="var(--brass-deep)" />
                {w.stack}
              </div>
            </div>
          </div>
        </div>
      ))
    }

    <style>
      /* Real headshot fills the design's portrait frame (4/5 blueprint card). */
      .portrait {
        background: var(--blueprint-800);
      }
      .portrait-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .portrait-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(11, 34, 54, 0.78), transparent 46%);
      }
      .portrait .reg-mark,
      .portrait .tag {
        position: relative;
        z-index: 1;
      }
    </style>

    <script>
      // Reveal-on-scroll
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      }

      // FAQ accordion — one open at a time
      document.querySelectorAll<HTMLButtonElement>(".faq-q").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = btn.closest(".faq-item");
          if (!item) return;
          const isOpen = item.classList.contains("open");
          document.querySelectorAll(".faq-item.open").forEach((o) => {
            o.classList.remove("open");
            o.querySelector(".faq-q")?.setAttribute("aria-expanded", "false");
          });
          if (!isOpen) {
            item.classList.add("open");
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });

      // Work case-study modals
      const closeModals = () => {
        document
          .querySelectorAll<HTMLElement>(".modal-scrim")
          .forEach((m) => (m.style.display = "none"));
        document.body.style.overflow = "";
      };
      document.querySelectorAll<HTMLElement>("[data-open-work]").forEach((card) => {
        card.addEventListener("click", () => {
          const id = card.getAttribute("data-open-work");
          const modal = document.querySelector<HTMLElement>(
            `.modal-scrim[data-modal="${id}"]`,
          );
          if (modal) {
            modal.style.display = "grid";
            document.body.style.overflow = "hidden";
          }
        });
      });
      document.querySelectorAll<HTMLElement>(".modal-scrim").forEach((scrim) => {
        scrim.addEventListener("click", (e) => {
          if (e.target === scrim) closeModals();
        });
      });
      document
        .querySelectorAll<HTMLButtonElement>(".modal .mclose")
        .forEach((b) => b.addEventListener("click", closeModals));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModals();
      });
    </script>
  </body>
</html>
